{
  "name": "design-engineering-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tokens:css": "node scripts/tokens/build-css.mjs",
    "tokens:check": "node scripts/tokens/check-css.mjs",
    "tokens:build": "npm run tokens:css && npm run tokens:check",
    "figma:typecheck": "tsc -p figma-plugin",
    "figma:bundle": "esbuild figma-plugin/code.ts --bundle --target=es2017 --outfile=figma-plugin/dist/code.js",
    "figma:build": "npm run figma:typecheck && npm test && npm run figma:bundle",
    "test": "node --test figma-plugin/tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@figma/plugin-typings": "^1.141.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "style-dictionary": "^5.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
