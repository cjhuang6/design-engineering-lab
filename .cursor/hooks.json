{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/protect-agents-md.mjs",
        "matcher": "Write",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/protect-agents-md.mjs",
        "matcher": "[Aa][Gg][Ee][Nn][Tt][Ss]\\.[Mm][Dd]",
        "failClosed": true,
        "timeout": 10
      }
    ]
  }
}
